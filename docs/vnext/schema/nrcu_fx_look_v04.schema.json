{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrcu.local/schema/nrcu_fx_look_v04.schema.json",
  "title": "NRCU FX Look v0.4",
  "type": "object",
  "required": [
    "schema",
    "look_id",
    "name",
    "layers",
    "revision",
    "status",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "NRCU_FX_LOOK_V0_4"
    },
    "look_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "PRODUCTION",
        "MIGRATION_REVIEW_REQUIRED"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "migrated_from": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position_px": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "$ref": "#/$defs/scale_vec2"
        },
        "rotation_deg": {
          "type": "number"
        },
        "pivot": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "flip_x": {
          "type": "boolean"
        },
        "flip_y": {
          "type": "boolean"
        }
      },
      "required": [
        "position_px",
        "scale",
        "rotation_deg",
        "pivot",
        "flip_x",
        "flip_y"
      ]
    },
    "displacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "driver": {
          "enum": [
            "NOISE",
            "DIRECTIONAL",
            "WAVE",
            "CELLULAR",
            "FRINGE_DRIVER",
            "CUSTOM_TEXTURE"
          ]
        },
        "amount_px": {
          "$ref": "#/$defs/vec2"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number"
        },
        "phase": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "angle_deg": {
          "type": "number"
        },
        "edge_mode": {
          "enum": [
            "TRANSPARENT",
            "CLAMP",
            "MIRROR",
            "REPEAT"
          ]
        },
        "custom_texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "influence_mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/mask"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_source": {
          "enum": [
            "PRESENTATION_TIME",
            "FREE_RUN"
          ]
        }
      },
      "required": [
        "enabled",
        "driver",
        "amount_px",
        "scale",
        "speed",
        "phase",
        "seed",
        "time_source",
        "angle_deg",
        "edge_mode",
        "custom_texture",
        "influence_mask"
      ]
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "NONE",
            "ORIGINAL_SOURCE_ALPHA",
            "POST_DISPLACEMENT_ALPHA",
            "CUSTOM_MASK"
          ]
        },
        "region": {
          "enum": [
            "FULL",
            "EDGE_BAND",
            "OUTER_BAND",
            "INNER_BAND"
          ]
        },
        "space": {
          "enum": [
            "SOURCE_SPACE",
            "LAYER_SPACE",
            "PRESENTATION_SPACE"
          ]
        },
        "expand_contract_px": {
          "type": "number"
        },
        "width_px": {
          "type": "number",
          "minimum": 0
        },
        "feather_px": {
          "type": "number",
          "minimum": 0
        },
        "invert": {
          "type": "boolean"
        },
        "custom_mask": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "source",
        "region",
        "space",
        "expand_contract_px",
        "width_px",
        "feather_px",
        "invert",
        "custom_mask"
      ]
    },
    "layer": {
      "type": "object",
      "required": [
        "layer_id",
        "name",
        "type",
        "enabled",
        "locked",
        "opacity",
        "blend_mode",
        "plane",
        "transform",
        "displacement",
        "mask",
        "fx",
        "motion"
      ],
      "additionalProperties": false,
      "properties": {
        "layer_id": {
          "type": "string",
          "minLength": 8
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "SOURCE",
            "SOURCE_COPY",
            "FX"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blend_mode": {
          "enum": [
            "NORMAL",
            "ADD",
            "SCREEN",
            "MULTIPLY"
          ]
        },
        "plane": {
          "enum": [
            "COMPOSITION_BACKGROUND",
            "TARGET_UNDERLAY",
            "TARGET_SOURCE",
            "TARGET_OVERLAY",
            "COMPOSITION_FOREGROUND"
          ]
        },
        "input": {
          "enum": [
            "ORIGINAL_SOURCE",
            "TRANSFORMED_SOURCE",
            "LAYER_BELOW",
            "COMPOSITE_BELOW"
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "displacement": {
          "$ref": "#/$defs/displacement"
        },
        "mask": {
          "$ref": "#/$defs/mask"
        },
        "fx": {
          "type": "object",
          "additionalProperties": true
        },
        "motion": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "FX"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "input"
            ]
          },
          "else": {
            "not": {
              "required": [
                "input"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SOURCE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "plane": {
                "const": "TARGET_SOURCE"
              }
            }
          }
        }
      ]
    },
    "scale_vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
